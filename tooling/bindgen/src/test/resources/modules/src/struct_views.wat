(module
  (type $bytes (array (mut i8)))
  (type $leaf (struct (field i32)))
  (rec
    (type $node (struct
      (field (mut i32))
      (field i64)
      (field (mut f32))
      (field f64)
      (field (mut i8))
      (field i16)
      (field (mut (ref null $node)))
      (field (ref $leaf))
      (field (mut (ref null $bytes)))
      (field (ref $bytes))
      (field (mut anyref)))))
  (rec
    (type $first (struct (field (ref null $second))))
    (type $second (struct (field (mut (ref null $first))) (field i32))))

  (func (export "make_leaf") (param i32) (result (ref $leaf))
    (struct.new $leaf (local.get 0)))
