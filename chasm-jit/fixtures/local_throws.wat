(module
  (import "tags" "boom" (tag $alias_a (param i32)))
  (import "tags" "boom" (tag $alias_b (param i32)))
  (import "tags" "spare" (tag $spare (param i32)))
  (tag $wide (param i64 externref))
  (tag $plain (param i32))
  (tag $other (param i32))

  (func (export "inner_miss_outer_match") (param i32) (result i32)
    (block $outer (result i32)
      (try_table (catch $plain $outer)
        (block $inner (result i32)
          (try_table (catch $other $inner)
            (throw $plain (local.get 0)))
          (return (i32.const -1)))
        (return (i32.const -2)))
      (return (i32.const -3)))
    (i32.const 1)
    (i32.add))

  (func (export "catch_all_then_continue") (param i32) (result i32)
    (block $caught
      (try_table (catch_all $caught) (throw $plain (local.get 0)))
      (return (i32.const -1)))
    (i32.add (local.get 0) (i32.const 2)))

  (func (export "rethrow_caught_reference") (param i32) (result i32)
    (block $outer (result i32)
      (try_table (catch $plain $outer)
        (block $inner (result exnref)
          (try_table (catch_all_ref $inner) (throw $plain (local.get 0)))
          (return (i32.const -1)))
        (throw_ref))
      (return (i32.const -2)))
    (i32.const 3)
    (i32.add))

  (func (export "wide_payload") (param i64) (result i64)
    (block $caught (result i64 externref)
      (try_table (catch $wide $caught) (throw $wide (local.get 0) (ref.null extern)))
      (return (i64.const -1)))
    (drop)
    (i64.const 4)
    (i64.add))

  (func (export "catch_ref_payload_and_reference") (param i32) (result i32)
    (block $caught (result i32 exnref)
      (try_table (catch_ref $plain $caught) (throw $plain (local.get 0)))
      (return (i32.const -1)))
    (drop)
    (i32.const 5)
    (i32.add))

  (func (export "imported_aliases_match") (param i32) (result i32)
    (block $caught (result i32)
      (try_table (catch $alias_b $caught) (throw $alias_a (local.get 0)))
      (return (i32.const -1)))
    (i32.const 6)
    (i32.add))

  (func (export "different_imported_tags_miss") (param i32) (result i32)
    (block $all
      (block $spared (result i32)
        (try_table (catch $spare $spared) (catch_all $all) (throw $alias_a (local.get 0)))
        (return (i32.const -1)))
      (return (i32.const -2)))
    (i32.add (local.get 0) (i32.const 7)))

  (func (export "imported_clause_skips_defined_throw") (param i32) (result i32)
    (block $plain_caught (result i32)
      (block $imported (result i32)
        (try_table (catch $alias_a $imported) (catch $plain $plain_caught) (throw $plain (local.get 0)))
        (return (i32.const -1)))
      (return (i32.const -2)))
    (i32.const 8)
    (i32.add))

  (func (export "throws_in_a_loop") (param $times i32) (result i32)
    (local $caught i32)
    (loop $again
      (block $handler (result i32)
        (try_table (catch $plain $handler) (throw $plain (local.get $caught)))
        (return (i32.const -1)))
      (drop)
      (local.set $caught (i32.add (local.get $caught) (i32.const 1)))
      (br_if $again (i32.lt_u (local.get $caught) (local.get $times))))
    (local.get $caught))

  (func (export "uncaught_propagates") (param i32)
    (block $caught (result i32)
      (try_table (catch $other $caught) (throw $plain (local.get 0)))
      (return))
    (drop))
)
