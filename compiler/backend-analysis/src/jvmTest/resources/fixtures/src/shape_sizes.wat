(module
  (type $empty (struct))
  (type $int (struct (field i32)))
  (type $mixed (struct (field i64) (field i8) (field i16)))
  (type $bytes (array (mut i8)))
  (type $chars (array (mut i16)))
  (type $ints (array (mut i32)))
  (type $longs (array (mut i64)))
  (type $doubles (array (mut f64)))
  (type $references (array (mut anyref)))
)
