(module
  (type $box (struct (field (mut i32))))
  (type $bytes (array (mut i8)))
  (type $boxes (array (mut (ref null $box))))
  (type $nothing (func))
  (type $make_box (func (result (ref $box))))
  (import "env" "host" (func $host))
  (export "host" (func $host))
  (memory 1)
  (table $functions 2 funcref)
  (table $references 1 externref)
  (tag $failure (param i32))
  (data $payload "\01\02\03\04")
  (elem $boxes_elem (ref null $box) (ref.null $box) (ref.null $box))
  (elem declare func $struct_new)

  ;; Reads, writes and copies of guest objects, and everything else that cannot allocate one.
  (func $get (export "get") (param $box (ref $box)) (result i32)
    (struct.get $box 0 (local.get $box)))

  (func $calls_get (export "calls_get") (param $box (ref $box)) (result i32)
    (call $get (local.get $box)))

  (func $touch_arrays (export "touch_arrays") (param $bytes (ref $bytes)) (param $boxes (ref $boxes)) (result i32)
    (array.set $bytes (local.get $bytes) (i32.const 0) (i32.const 1))
    (array.fill $bytes (local.get $bytes) (i32.const 0) (i32.const 2) (i32.const 1))
    (array.copy $bytes $bytes (local.get $bytes) (i32.const 0) (local.get $bytes) (i32.const 1) (i32.const 1))
    (array.init_data $bytes $payload (local.get $bytes) (i32.const 0) (i32.const 0) (i32.const 1))
    (array.init_elem $boxes $boxes_elem (local.get $boxes) (i32.const 0) (i32.const 0) (i32.const 1))
    (i32.add (array.len (local.get $bytes)) (array.get_u $bytes (local.get $bytes) (i32.const 0))))

  (func $touch_references (export "touch_references") (param $box (ref null $box)) (param $extern externref) (result i32)
    (drop (any.convert_extern (local.get $extern)))
    (drop (extern.convert_any (local.get $box)))
    (drop (ref.i31 (i32.const 1)))
    (drop (ref.func $struct_new))
    (drop (ref.test (ref $box) (local.get $box)))
    (drop (ref.cast (ref null $box) (local.get $box)))
    (drop (ref.is_null (local.get $box)))
    (drop (ref.eq (local.get $box) (local.get $box)))
    (table.set $references (i32.const 0) (local.get $extern))
    (drop (table.get $references (i32.const 0)))
    (drop (table.grow $references (ref.null extern) (i32.const 1)))
    (drop (table.size $references))
    (memory.fill (i32.const 0) (i32.const 0) (i32.const 1))
    (i32.const 0))

  (func $rethrows (export "rethrows") (param $exception exnref)
    (throw_ref (local.get $exception)))

  (func $even (export "even") (param $n i32) (param $box (ref $box)) (result i32)
    (if (result i32) (i32.eqz (local.get $n))
      (then (struct.get $box 0 (local.get $box)))
      (else (call $odd (i32.sub (local.get $n) (i32.const 1)) (local.get $box)))))

  (func $odd (export "odd") (param $n i32) (param $box (ref $box)) (result i32)
    (call $even (local.get $n) (local.get $box)))

  ;; Every allocation, with each of its operands both constant and computed.
  (func $struct_new (export "struct_new") (result (ref $box))
    (struct.new $box (i32.const 1)))
  (func $struct_new_default (export "struct_new_default") (result (ref $box))
    (struct.new_default $box))
  (func $array_new_ii (export "array_new_ii") (result (ref $bytes))
    (array.new $bytes (i32.const 0) (i32.const 4)))
  (func $array_new_is (export "array_new_is") (param $length i32) (result (ref $bytes))
    (array.new $bytes (i32.const 0) (local.get $length)))
  (func $array_new_si (export "array_new_si") (param $value i32) (result (ref $bytes))
    (array.new $bytes (local.get $value) (i32.const 4)))
  (func $array_new_ss (export "array_new_ss") (param $value i32) (param $length i32) (result (ref $bytes))
    (array.new $bytes (local.get $value) (local.get $length)))
  (func $array_new_default_i (export "array_new_default_i") (result (ref $bytes))
    (array.new_default $bytes (i32.const 4)))
  (func $array_new_default_s (export "array_new_default_s") (param $length i32) (result (ref $bytes))
    (array.new_default $bytes (local.get $length)))
  (func $array_new_fixed (export "array_new_fixed") (result (ref $bytes))
    (array.new_fixed $bytes 2 (i32.const 0) (i32.const 1)))
  (func $array_new_data_ii (export "array_new_data_ii") (result (ref $bytes))
    (array.new_data $bytes $payload (i32.const 0) (i32.const 2)))
  (func $array_new_data_is (export "array_new_data_is") (param $length i32) (result (ref $bytes))
    (array.new_data $bytes $payload (i32.const 0) (local.get $length)))
  (func $array_new_data_si (export "array_new_data_si") (param $offset i32) (result (ref $bytes))
    (array.new_data $bytes $payload (local.get $offset) (i32.const 2)))
  (func $array_new_data_ss (export "array_new_data_ss") (param $offset i32) (param $length i32) (result (ref $bytes))
    (array.new_data $bytes $payload (local.get $offset) (local.get $length)))
  (func $array_new_elem_ii (export "array_new_elem_ii") (result (ref $boxes))
    (array.new_elem $boxes $boxes_elem (i32.const 0) (i32.const 1)))
  (func $array_new_elem_is (export "array_new_elem_is") (param $length i32) (result (ref $boxes))
    (array.new_elem $boxes $boxes_elem (i32.const 0) (local.get $length)))
  (func $array_new_elem_si (export "array_new_elem_si") (param $offset i32) (result (ref $boxes))
    (array.new_elem $boxes $boxes_elem (local.get $offset) (i32.const 1)))
  (func $array_new_elem_ss (export "array_new_elem_ss") (param $offset i32) (param $length i32) (result (ref $boxes))
    (array.new_elem $boxes $boxes_elem (local.get $offset) (local.get $length)))
  (func $throws (export "throws")
    (throw $failure (i32.const 1)))

  ;; Calls that reach a collection, or may.
  (func $via_alloc (export "via_alloc") (result (ref $box))
    (call $struct_new))

  (func $calls_chain (export "calls_chain") (param $box (ref $box)) (result i32)
    (drop (call $via_alloc))
    (struct.get $box 0 (local.get $box)))

  (func $cycle_a (export "cycle_a") (param $n i32) (result (ref $box))
    (if (result (ref $box)) (i32.eqz (local.get $n))
      (then (struct.new $box (i32.const 0)))
      (else (call $cycle_b (i32.sub (local.get $n) (i32.const 1))))))

  (func $cycle_b (export "cycle_b") (param $n i32) (result (ref $box))
    (call $cycle_a (local.get $n)))

  (func $calls_import (export "calls_import") (param $box (ref $box)) (result i32)
    (call $host)
    (struct.get $box 0 (local.get $box)))

  (func $calls_indirect (export "calls_indirect") (param $box (ref $box)) (result i32)
    (call_indirect $functions (type $nothing) (i32.const 0))
    (struct.get $box 0 (local.get $box)))

  (func $calls_indirect_dynamic (export "calls_indirect_dynamic") (param $box (ref $box)) (param $index i32) (result i32)
    (call_indirect $functions (type $nothing) (local.get $index))
    (struct.get $box 0 (local.get $box)))

  (func $calls_ref (export "calls_ref") (param $box (ref $box)) (param $function (ref $nothing)) (result i32)
    (call_ref $nothing (local.get $function))
    (struct.get $box 0 (local.get $box)))

  (func $tail_alloc (export "tail_alloc") (param $box (ref $box)) (result (ref $box))
    (return_call $struct_new))

  (func $tail_indirect (export "tail_indirect") (param $box (ref $box)) (result (ref $box))
    (return_call_indirect $functions (type $make_box) (i32.const 1)))

  (func $tail_ref (export "tail_ref") (param $box (ref $box)) (param $function (ref $make_box)) (result (ref $box))
    (return_call_ref $make_box (local.get $function)))

  (func $calls_tail_alloc (export "calls_tail_alloc") (param $box (ref $box)) (result i32)
    (drop (call $tail_alloc (local.get $box)))
    (struct.get $box 0 (local.get $box)))

  ;; Memory growth, directly and through calls.
  (func $grows (export "grows") (result i32)
    (memory.grow (i32.const 1)))
  (func $calls_grows (export "calls_grows") (result i32)
    (call $grows))
  (func $tail_grows (export "tail_grows") (result i32)
    (return_call $grows)))
