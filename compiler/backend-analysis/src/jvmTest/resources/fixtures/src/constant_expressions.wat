(module
  (type $box (struct (field i32)))
  (import "env" "number" (global $number i32))
  (import "env" "reference" (global $reference (ref null $box)))
  (global $plain i32 (i32.const 1))
  (global $boxed (ref $box) (struct.new $box (i32.const 7)))
  (global $copied (ref null $box) (global.get $reference))
  (global $counted i32 (global.get $number))
  (table $functions 1 funcref)
  (table $boxes 1 (ref null $box) (struct.new $box (i32.const 3)))
  (elem (table $functions) (i32.const 0) func $target)
  (elem (ref null $box) (item (struct.new $box (i32.const 2))))
  (func $target)
)
