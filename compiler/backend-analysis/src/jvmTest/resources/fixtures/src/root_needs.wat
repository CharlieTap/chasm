(module
  (type $box (struct (field i32)))
  (import "env" "host" (func $host))
  (tag $raised (param (ref null $box)))

  (func (export "roots") (param $first (ref $box)) (param $second (ref $box)) (result i32)
    (local $kept (ref null $box))
    (local $dropped (ref null $box))
    (local.set $kept (local.get $first))
    (local.set $dropped (local.get $second))
    (drop (struct.get $box 0 (ref.as_non_null (local.get $dropped))))
    (call $host)
    (struct.get $box 0 (ref.as_non_null (local.get $kept))))

  (func (export "caught") (param $first (ref $box)) (result i32)
    (local $kept (ref null $box))
    (block $handler (result (ref null $box))
      (try_table (catch $raised $handler)
        (local.set $kept (local.get $first))
        (call $host)
        (return (i32.const 0)))
      (unreachable))
    (drop)
    (struct.get $box 0 (ref.as_non_null (local.get $kept))))

  (func (export "dead") (param $first (ref $box)) (result i32)
    (local $value i32)
    (local.set $value (struct.get $box 0 (local.get $first)))
    (call $host)
    (local.get $value)))
