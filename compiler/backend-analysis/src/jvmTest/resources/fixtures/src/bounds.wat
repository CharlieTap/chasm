(module
  (memory 1)
  (memory $other 1)
  (tag $raised)
  (func (export "covered") (param $p i32) (result i32)
    (i32.add (i32.load offset=8 (local.get $p)) (i32.load offset=4 (local.get $p))))
  (func (export "further") (param $p i32) (result i32)
    (i32.add (i32.load offset=4 (local.get $p)) (i32.load offset=8 (local.get $p))))
  (func (export "rewritten") (param $p i32) (result i32)
    (local $first i32)
    (local.set $first (i32.load offset=8 (local.get $p)))
    (local.set $p (i32.add (local.get $p) (i32.const 8)))
    (i32.add (local.get $first) (i32.load offset=4 (local.get $p))))
  (func (export "joined") (param $p i32) (param $skip i32) (result i32)
    (local $first i32)
    (block $join
      (br_if $join (local.get $skip))
      (local.set $first (i32.load offset=8 (local.get $p))))
    (i32.add (local.get $first) (i32.load offset=4 (local.get $p))))
  (func (export "arms") (param $p i32) (param $c i32) (result i32)
    (i32.add
      (if (result i32) (local.get $c)
        (then (i32.load offset=8 (local.get $p)))
        (else (i32.load offset=12 (local.get $p))))
      (i32.load offset=4 (local.get $p))))
  (func (export "looped") (param $p i32) (param $n i32) (result i32)
    (local $sum i32)
    (local.set $sum (i32.load (local.get $p)))
    (block $done
      (loop $again
        (br_if $done (i32.eqz (local.get $n)))
        (local.set $sum (i32.add (local.get $sum) (i32.load (local.get $p))))
        (local.set $n (i32.sub (local.get $n) (i32.const 1)))
        (br $again)))
    (local.get $sum))
  (func (export "copied") (param $p i32) (result i32)
    (local $first i32)
    (local $q i32)
    (local.set $first (i32.load offset=8 (local.get $p)))
    (local.set $q (local.get $p))
    (i32.add (local.get $first) (i32.load offset=4 (local.get $q))))
  (func (export "crossed") (param $p i32) (param $n i32) (result i32)
    (local $sum i32)
    (local.set $sum (i32.load offset=8 (local.get $p)))
    (loop $outer
      (local.set $n (i32.sub (local.get $n) (i32.const 1)))
      (loop $inner
        (local.set $sum (i32.add (local.get $sum) (i32.load offset=4 (local.get $p))))
        (br_if $outer (i32.eqz (local.get $n)))
        (br_if $inner (local.get $n))))
    (local.get $sum))
  (func (export "handled") (param $p i32) (param $c i32) (result i32)
    (local $first i32)
    (local.set $first (i32.load offset=8 (local.get $p)))
    (block $caught
      (try_table (catch $raised $caught)
        (if (local.get $c) (then (throw $raised)))))
    (i32.add (local.get $first) (i32.load offset=4 (local.get $p))))
  (func (export "killed") (param $p i32) (param $q i32) (param $n i32) (result i32)
    (local $sum i32)
    (local.set $sum (i32.add (i32.load offset=8 (local.get $p)) (i32.load offset=8 (local.get $q))))
    (block $done
      (loop $again
        (br_if $done (i32.eqz (local.get $n)))
        (local.set $sum (i32.add (local.get $sum) (i32.add (i32.load offset=4 (local.get $p)) (i32.load offset=4 (local.get $q)))))
        (local.set $q (i32.add (local.get $q) (i32.const 4)))
        (local.set $n (i32.sub (local.get $n) (i32.const 1)))
        (br $again)))
    (local.get $sum))
  (func (export "kept") (param $p i32) (param $q i32) (param $r i32) (param $s i32) (param $n i32) (result i32)
    (local $sum i32)
    (local.set $sum (i32.add (i32.load offset=8 (local.get $p)) (i32.load offset=8 (local.get $q))))
    (block $done
      (loop $again
        (br_if $done (i32.eqz (local.get $n)))
        (local.set $sum (i32.add (local.get $sum) (i32.add (i32.load offset=4 (local.get $p)) (i32.load offset=4 (local.get $q)))))
        (local.set $q (i32.add (local.get $q) (i32.const 4)))
        (local.set $r (i32.add (local.get $r) (i32.const 4)))
        (local.set $s (i32.add (local.get $s) (i32.const 4)))
        (local.set $sum (i32.add (local.get $sum) (i32.load (local.get $r))))
        (local.set $sum (i32.add (local.get $sum) (i32.load (local.get $s))))
        (local.set $n (i32.sub (local.get $n) (i32.const 1)))
        (br $again)))
    (local.get $sum))
  (func (export "other") (param $p i32) (result i32)
    (i32.add (i32.load $other offset=8 (local.get $p)) (i32.load $other offset=4 (local.get $p)))))
