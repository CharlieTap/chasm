(module
  (type $point (struct (field i32)))

  (import "env" "make" (func $make (param i32) (result externref)))
  (import "env" "reenter" (func $reenter))
  (import "env" "reenter_middle" (func $reenter_middle))
  (import "env" "collect" (func $collect))
  (import "env" "check" (func $check (param externref i32)))

  (func $churn (export "churn")
    (local $index i32)
    (call $collect)
    (loop $allocate
      (drop (struct.new $point (i32.const -1)))
      (drop (call $make (i32.const -1)))
      (local.set $index (i32.add (local.get $index) (i32.const 1)))
      (br_if $allocate (i32.lt_u (local.get $index) (i32.const 4096)))
    )
  )

  (func (export "middle")
    (call $reenter)
  )

  (func (export "across_reentry")
    (local $extern externref)
    (local $point (ref null $point))
    (local.set $extern (call $make (i32.const 7)))
    (local.set $point (struct.new $point (i32.const 42)))
    (call $reenter)
    (call $check (local.get $extern) (struct.get $point 0 (local.get $point)))
  )

  (func (export "across_double_reentry")
    (local $extern externref)
    (local $point (ref null $point))
    (local.set $extern (call $make (i32.const 7)))
    (local.set $point (struct.new $point (i32.const 42)))
    (call $reenter_middle)
    (call $check (local.get $extern) (struct.get $point 0 (local.get $point)))
  )

  (func (export "across_host_collect")
    (local $extern externref)
    (local $point (ref null $point))
    (local.set $extern (call $make (i32.const 7)))
    (local.set $point (struct.new $point (i32.const 42)))
    (call $collect)
    (call $churn)
    (call $check (local.get $extern) (struct.get $point 0 (local.get $point)))
  )
)
