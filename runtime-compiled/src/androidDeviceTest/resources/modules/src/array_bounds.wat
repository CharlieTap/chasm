(module
  (type $bytes (array (mut i8)))
  (type $shorts (array (mut i16)))
  (type $ints (array (mut i32)))
  (type $longs (array (mut i64)))
  (type $floats (array (mut f32)))
  (type $doubles (array (mut f64)))
  (type $refs (array (mut anyref)))
  (import "host" "explode" (func $explode))
  (global $shared (mut (ref null $ints)) (ref.null $ints))
  (func (export "get_bytes") (param $index i32) (result i32)
    (drop (array.get_s $bytes (array.new_default $bytes (i32.const 4)) (local.get $index)))
    (i32.const 1))
  (func (export "set_bytes") (param $index i32) (result i32)
    (array.set $bytes (array.new_default $bytes (i32.const 4)) (local.get $index) (i32.const 1))
    (i32.const 1))
  (func (export "get_shorts") (param $index i32) (result i32)
    (drop (array.get_s $shorts (array.new_default $shorts (i32.const 4)) (local.get $index)))
    (i32.const 1))
  (func (export "set_shorts") (param $index i32) (result i32)
    (array.set $shorts (array.new_default $shorts (i32.const 4)) (local.get $index) (i32.const 1))
    (i32.const 1))
  (func (export "get_ints") (param $index i32) (result i32)
    (drop (array.get $ints (array.new_default $ints (i32.const 4)) (local.get $index)))
    (i32.const 1))
  (func (export "set_ints") (param $index i32) (result i32)
    (array.set $ints (array.new_default $ints (i32.const 4)) (local.get $index) (i32.const 1))
    (i32.const 1))
  (func (export "get_longs") (param $index i32) (result i32)
    (drop (array.get $longs (array.new_default $longs (i32.const 4)) (local.get $index)))
    (i32.const 1))
  (func (export "set_longs") (param $index i32) (result i32)
    (array.set $longs (array.new_default $longs (i32.const 4)) (local.get $index) (i64.const 1))
    (i32.const 1))
  (func (export "get_floats") (param $index i32) (result i32)
    (drop (array.get $floats (array.new_default $floats (i32.const 4)) (local.get $index)))
    (i32.const 1))
  (func (export "set_floats") (param $index i32) (result i32)
    (array.set $floats (array.new_default $floats (i32.const 4)) (local.get $index) (f32.const 1))
    (i32.const 1))
  (func (export "get_doubles") (param $index i32) (result i32)
    (drop (array.get $doubles (array.new_default $doubles (i32.const 4)) (local.get $index)))
    (i32.const 1))
  (func (export "set_doubles") (param $index i32) (result i32)
    (array.set $doubles (array.new_default $doubles (i32.const 4)) (local.get $index) (f64.const 1))
    (i32.const 1))
  (func (export "get_refs") (param $index i32) (result i32)
    (drop (array.get $refs (array.new_default $refs (i32.const 4)) (local.get $index)))
    (i32.const 1))
  (func (export "set_refs") (param $index i32) (result i32)
    (array.set $refs (array.new_default $refs (i32.const 4)) (local.get $index) (ref.i31 (i32.const 1)))
    (i32.const 1))
  (func (export "set_shared") (param $index i32) (param $value i32)
    (if (ref.is_null (global.get $shared))
      (then (global.set $shared (array.new_default $ints (i32.const 4)))))
    (array.set $ints (global.get $shared) (local.get $index) (local.get $value)))
  (func (export "read_shared") (param $index i32) (result i32)
    (array.get $ints (global.get $shared) (local.get $index)))
  (func (export "trap_inside_catch_all") (param $index i32) (result i32)
    (block $caught
      (try_table (catch_all $caught)
        (drop (array.get $ints (array.new_default $ints (i32.const 4)) (local.get $index))))
      (return (i32.const 1)))
    (i32.const -1))
  (func (export "host_failure") (result i32)
    (call $explode)
    (i32.const 1))
)
