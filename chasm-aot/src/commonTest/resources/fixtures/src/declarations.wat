(module $declarations
  (rec
    (type $point (struct (field $x (mut i32)) (field $y i32)))
    (type $pair (struct (field (ref null $point)) (field (ref null $pair)))))
  (type $unary (func (param i32) (result i32)))
  (tag $oops (param i32))
  (memory 1)
  (table $direct 2 funcref)
  (table $passive 1 funcref)
  (global $started (mut i32) (i32.const 0))
  (global $base i32 (i32.const 40))
  (data (i32.const 8) "\2a\00\00\00")
  (data $later "\07\00\00\00")
  (elem (table $direct) (i32.const 0) func $double $square)
  (elem $spare func $square)
  (elem declare func $double)
  (@custom "other" "dropped")

  (func $double (type $unary) (i32.mul (local.get 0) (i32.const 2)))
  (func $square (type $unary) (i32.mul (local.get 0) (local.get 0)))
  (func $start (global.set $started (i32.add (global.get $started) (global.get $base))))
  (start $start)

  (func (export "started") (result i32) (global.get $started))
  (func (export "active_data") (result i32) (i32.load (i32.const 8)))
  (func (export "passive_data") (result i32)
    (memory.init $later (i32.const 16) (i32.const 0) (i32.const 4))
    (data.drop $later)
    (i32.load (i32.const 16)))
  (func (export "call_direct") (param i32 i32) (result i32)
    (call_indirect $direct (type $unary) (local.get 1) (local.get 0)))
  (func (export "call_passive") (param i32) (result i32)
    (table.init $passive $spare (i32.const 0) (i32.const 0) (i32.const 1))
    (call_indirect $passive (type $unary) (local.get 0) (i32.const 0)))
  (func (export "reference") (param i32) (result i32)
    (call_ref $unary (local.get 0) (ref.func $double)))
  (func (export "struct") (param i32) (result i32)
    (struct.get $point $x (struct.new $point (local.get 0) (i32.const 1))))
  (func (export "catch") (param i32) (result i32)
    (block $handler (result i32)
      (try_table (catch $oops $handler) (throw $oops (local.get 0)))
      (i32.const -1))))
